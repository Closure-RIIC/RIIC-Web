# Optional local paths for a solver binary and its data directory.
INFRA_CLI_PATH=
ARKNIGHTS_INFRA_DATA_DIR=

# Authentication is initialized lazily; these are required only for auth requests and migrations.
APP_DEPLOYMENT_ENV=development
PUBLIC_DEFAULT_LOCALE=zh
# production enables Skland only for the exact value 1; development/local can use 0 to disable it.
SKLAND_FEATURE_ENABLED=1
SKLAND_SESSION_SECRET=replace-with-at-least-32-random-bytes
BETA_PUBLIC_ORIGIN=http://127.0.0.1:5174
SKLAND_PUBLIC_ORIGIN=http://127.0.0.1:5174
DATABASE_URL=postgresql://arknights_runtime:change-me@127.0.0.1:55433/arknights_infra_auth
DATABASE_MIGRATION_URL=postgresql://arknights_migration:change-me@127.0.0.1:55433/arknights_infra_auth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://127.0.0.1:5174
BETTER_AUTH_ADMIN_USER_IDS=
RESEND_API_KEY=
AUTH_EMAIL_FROM=基建排班助手 <auth@example.com>
# Resend stays primary. Set to aliyun only for an intentional full migration.
AUTH_EMAIL_PROVIDER=resend
# Set to aliyun after configuring and verifying all four ALIYUN_DM_* values below.
AUTH_EMAIL_FALLBACK_PROVIDER=none
# Must match the Direct Mail console region: cn-hangzhou, ap-southeast-1, us-east-1, eu-central-1.
ALIYUN_DM_REGION_ID=
# Bare verified sender address (no display name).
ALIYUN_DM_ACCOUNT_NAME=
# Dedicated server-side RAM credentials; see docs/AUTH_EMAIL_FALLBACK.md.
ALIYUN_DM_ACCESS_KEY_ID=
ALIYUN_DM_ACCESS_KEY_SECRET=

# Business-data phases are enabled independently after migrations and observation.
BETA_BUSINESS_DB_ENABLED=0
BETA_BUSINESS_DB_READ_ENABLED=0
BETA_BUSINESS_FILE_READ_FALLBACK=1
ACCOUNT_CLOUD_SYNC_ENABLED=0
# JSON object whose values use base64:... and decode to exactly 32 bytes.
WORKSPACE_ACTIVE_KEY_VERSION=v1
WORKSPACE_MASTER_KEYS={"v1":"base64:replace-with-32-random-bytes"}
PLAN_CACHE_ENABLED=0
PLAN_CACHE_HMAC_KEY=base64:replace-with-at-least-32-random-bytes
# The queue additionally requires business DB writes, workspace keys and the cache HMAC key.
PLAN_TASK_QUEUE_ENABLED=0
# Required by the independent worker; production deployment injects the verified commit SHA.
APP_RELEASE_SHA=0000000000000000000000000000000000000000

# Agent chat (exploration prototype, see docs/AGENT_EXPLORATION.md).
# Server runtime rollout: admin (default), public, disabled.
# Missing/invalid values remain admin-only. See docs/FEATURE_ROLLOUT.md.
AGENT_ACCESS_MODE=admin
BILLING_ACCESS_MODE=admin
# Provider preset: deepseek (default) or glm; both use OpenAI-compatible APIs.
AGENT_LLM_PROVIDER=deepseek
# Optional overrides for the preset base URL / model name.
## Optional private Magpie gateway (keep disabled until migrations and the worker are deployed).
AGENT_GATEWAY_ENABLED=0
AGENT_GATEWAY_URL=http://127.0.0.1:3426/v1
AGENT_GATEWAY_KEY=
AGENT_GATEWAY_POLICY_DIR=
AGENT_LLM_BASE_URL=
AGENT_LLM_MODEL=
AGENT_LLM_API_KEY=
# Optional independently configured models. Only configured entries are shown.
# Legacy AGENT_LLM_* values apply only to AGENT_LLM_PROVIDER.
AGENT_LLM_DEEPSEEK_BASE_URL=
AGENT_LLM_DEEPSEEK_MODEL=
AGENT_LLM_DEEPSEEK_API_KEY=
AGENT_LLM_GLM_BASE_URL=
AGENT_LLM_GLM_MODEL=
AGENT_LLM_GLM_API_KEY=
# Local path of the RIIC-knowledge repository used by kb_route / kb_read tools.
AGENT_KB_DIR=E:/arknights-infra-project/RIIC-knowledge
# Persona card file for the agent assistant. The card content lives in a separate
# private repository and is NOT distributed with this repo; point this to a local
# file (e.g. a cloned person-card repo). When unset, a neutral fallback persona is used.
AGENT_PERSONA_CARD=
# Optional private SilverAsh Markdown file. A readable card appears in the persona picker.
AGENT_PERSONA_SILVERASH_CARD=
# Optional private Exusiai Markdown file, same limits as SilverAsh.
AGENT_PERSONA_EXUSIAI_CARD=
# Optional private Saileach Markdown file, same limits as the other built-in personas.
AGENT_PERSONA_SAILEACH_CARD=
# Optional private Mountain Markdown file, same limits as the other built-in personas.
AGENT_PERSONA_MOUNTAIN_CARD=
# RMB per million tokens for GLM-5.3-Flash (cached input is a separate bucket).
AGENT_GLM_INPUT_RMB_PER_MILLION=1.08
AGENT_GLM_CACHED_INPUT_RMB_PER_MILLION=0.216
AGENT_GLM_OUTPUT_RMB_PER_MILLION=3.6

# Each Afdian item/plan has its own price. Do not reuse one URL for multiple tiers.
# The legacy URL is accepted only as the 5 RMB checkout during local migration.
AFDIAN_TEST_PAYMENT_URL=
AFDIAN_PAYMENT_URL_POINTS_1_TEST=
AFDIAN_PAYMENT_URL_POINTS_5=
AFDIAN_PAYMENT_URL_POINTS_10=
AFDIAN_PAYMENT_URL_MONTHLY_19_9=
AFDIAN_API_TOKEN=
# Required by Afdian's signed query-order API; find it in the creator developer console.
AFDIAN_USER_ID=
AFDIAN_API_BASE_URL=https://afdian.net/api/open/query-order
AFDIAN_WEBHOOK_SECRET=
BILLING_PROTOTYPE_MODE=1
# Optional independent platform. Omit PLATFORM_API_ORIGIN to run the existing
# in-process routes during rollout. Configure origins on the platform service too.
PLATFORM_API_ORIGIN=
PLATFORM_PUBLIC_ORIGINS=
AUTH_COOKIE_DOMAIN=
