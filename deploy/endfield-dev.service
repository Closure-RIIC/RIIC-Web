[Unit]
Description=RIIC Endfield development application
After=network-online.target arknights-infra-dev.service
Wants=network-online.target

[Service]
Type=simple
User=riic-endfield-dev
Group=riic-endfield-dev
WorkingDirectory=/srv/riic-endfield-dev/current
EnvironmentFile=/etc/riic/endfield-dev.env
ExecStart=/usr/local/bin/node /srv/riic-endfield-dev/current/runtime/server/index.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
