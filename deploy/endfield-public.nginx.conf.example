# Use only for ENDFIELD_ACCESS_MODE=public, inside the trusted HTTPS server.
# Keep the existing narrow /api/skland/ location and its origin validation.
# For administrator previews, use endfield-admin.nginx.conf.example instead.
location / {
    proxy_pass http://127.0.0.1:4186;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For "";
    proxy_set_header CF-Connecting-IP "";
    proxy_set_header Connection "";
    proxy_cache off;
    # Pass the application's Cache-Control and Vary through unchanged:
    # immutable hashed assets, short-lived images, private/no-store HTML and APIs.
    # Do not append private/no-store or Vary: Cookie to every public static response.
}
