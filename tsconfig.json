{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "workbench-inventory-route": [
        "./apps/arknights/src/components/pages/InventoryPage.tsx"
      ],
      "@/*": [
        "./apps/arknights/src/*"
      ],
      "account-cloud-workspace-bridge": [
        "./apps/arknights/src/components/cloud/useAccountCloudWorkspace.tsx"
      ],
      "workbench-skland-route": [
        "./apps/arknights/src/components/workbench/SklandRoute.tsx"
      ]
    },
    "tsBuildInfoFile": "./node_modules/.cache/tooling.tsbuildinfo"
  },
  "include": [
    "playwright*.config.ts",
    "drizzle.config.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "**/.output"
  ]
}
