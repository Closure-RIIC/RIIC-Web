{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@endfield/*": [
        "./src/*"
      ]
    },
    "tsBuildInfoFile": "./node_modules/.cache/endfield.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".output",
    "../../packages/**/*.test.ts"
  ]
}
