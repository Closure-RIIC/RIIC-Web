# Shared platform service. Loopback HTTP is allowed behind the trusted ingress.
PLATFORM_API_ORIGIN=http://127.0.0.1:5177
# Compatibility only: ENDFIELD_ACCOUNT_ORIGIN can still target an older deployment.
# Public by default. Set admin only for an explicitly private preview deployment.
ENDFIELD_ACCESS_MODE=public
# Optional public navigation destination for the Arknights application.
VITE_ARKNIGHTS_ORIGIN=http://127.0.0.1:5174
