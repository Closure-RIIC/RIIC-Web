  "app_help_owned_operators_page_content": {
    "value": [
      "開啟排班設定",
      "回到基建計算器。電腦端點頂部「配置Box與佈局」；手機端先點「更多工具」，再點同名按鈕。"
    ]
  },
  "app_help_owned_operators_page_content2": {
    "value": [
      "回到第 1 步「幹員資料」",
      "如果彈窗直接顯示佈局或設施，不用關閉。點頂部進度條最左側的「幹員資料」。"
    ]
  },
  "app_help_owned_operators_page_content3": {
    "value": [
      "點當前資料右側的「更換」",
      "展開資料來源選項。不要點頁面外面的「全形色匯入」，它只會載入體驗用的全精二示例。"
    ]
  },
  "app_help_owned_operators_page_content4": {
    "value": [
      "匯入你自己的 Box",
      "選擇森空島同步，或點選上傳入口，在彈窗內拖入或選擇 MAA 匯出的 Arknights_OperBox_Export.json。兩種方式選一種即可。"
    ]
  },
  "app_help_owned_operators_page_content5": {
    "value": [
      "完成設定並重新生成",
      "按介面提示點「繼續」或「檢查設施」，核對佈局與設施，再點「完成」。回到計算器後重新生成排班。"
    ]
  }
